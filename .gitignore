# Microsoft Office documents
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt

# Agents
*.SKILL.md
# Allow .claude/CLAUDE.md — session protocol is version-controlled
!.claude/
!.claude/CLAUDE.md

# Local native dev (scripts/dev-local.sh)
.dev-local/

# OS files
.DS_Store
Thumbs.db

# Environment — never commit real secrets
.env
backend/.env
frontend/.env.local

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.next-prod/

# Backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.venv/
backend/test.db

# Alembic
backend/alembic/versions/*.pyc
frontend/tsconfig.tsbuildinfo
