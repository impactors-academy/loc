# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://loc:loc@localhost:5432/loc

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Editor auth — REQUIRED ───────────────────────────────────────────────────
# Gates every write endpoint (POST/PUT/DELETE on experiences, stays, products,
# blog) and all /leads routes, which expose customer PII. Also the key the
# mother dashboard (impactors-academy /admin/network) uses to cross-post blog
# drafts here — set the same value as its LOC_EDITOR_API_KEY.
#
# Fails closed: if this is blank, those routes return 503 and the team cannot
# publish. It must be set in every deployed environment.
#
# Generate one with:  openssl rand -hex 32
EDITOR_API_KEY=

# ── AI / Embeddings (R3 EXP-6) ───────────────────────────────────────────────
# Leave blank to run keyword-only search; set to enable pgvector hybrid search
OPENAI_API_KEY=

# ── Email / Lead notifications (STAY-4) ──────────────────────────────────────
# Leave blank to log inquiries only (no email sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@loctravels.com
EMAIL_TO=

# ── Cloudflare R2 (image uploads for admin dashboard) ────────────────────────
# Leave blank to disable uploads — the presign endpoint returns 503 and the
# admin UI falls back to pasting a URL directly.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are secrets: set via Vaultwarden ->
# Coolify in every deployed environment, never commit real values here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loc-media
R2_PUBLIC_BASE_URL=

# Note: PGADMIN_* and POSTGRES_* belong in the repo-root .env (docker-compose
# reads them), not here — this file configures the backend app only.
