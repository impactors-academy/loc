# ---- Postgres ----
POSTGRES_USER=loc
POSTGRES_PASSWORD=loc
POSTGRES_DB=loc

# ---- Backend ----
# Inside Docker the host is the service name `db` / `redis` (already wired in compose).
# +psycopg2 driver suffix is required by SQLAlchemy — do not remove it.
DATABASE_URL=postgresql+psycopg2://loc:loc@db:5432/loc
REDIS_URL=redis://redis:6379/0
# Comma-separated, or a JSON array. Both are accepted.
CORS_ORIGINS=http://localhost:3000
ENV=development

# Gates every write endpoint (POST/PUT/DELETE) and all /leads routes, and is what
# the frontend's /api/admin/* proxy attaches server-side. Fails closed: leaving it
# unset returns 503 rather than granting open access, so /admin cannot save without
# it. Any non-empty string works locally; use a real secret everywhere else.
EDITOR_API_KEY=dev-local-editor-key

# ---- Frontend ----
# NEXT_PUBLIC_API_URL  → baked into the JS bundle; used by the browser for direct API calls.
#                        Points to the public-facing host (localhost in dev, domain in prod).
NEXT_PUBLIC_API_URL=http://localhost:8000

# API_INTERNAL_URL → server-side only (Next.js API proxy routes, SSR).
#                    Inside Docker this hits the backend service by name, not localhost.
#                    Never prefixed NEXT_PUBLIC_ — never exposed to the browser.
API_INTERNAL_URL=http://backend:8000

# Cloudflare Access — verified at the origin by frontend/middleware.ts, which is the
# second layer behind the Access policy at the edge. Both values come from the Access
# application (Zero Trust → Access → Applications → your app → Overview); neither is a
# secret. Leave them blank locally: there is no Access in front of a dev server, so the
# check stands aside in development. In production, blank means /admin and /api/admin
# return 503 — fail-closed, same posture as EDITOR_API_KEY.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---- Phase 2 (semantic search) — leave blank until enabled ----
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
