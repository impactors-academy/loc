NEXT_PUBLIC_API_URL=http://localhost:8000

# API_INTERNAL_URL → server-side only. Inside Docker this reaches the backend by
# service name rather than localhost. Never prefixed NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:8000

# EDITOR_API_KEY → server-side only. Must match the backend's EDITOR_API_KEY.
#
# The dashboard at /dashboard writes through /api/admin/*, which attaches this
# key on the server. Without it those routes return 503 and the dashboard
# cannot publish or read inquiries.
#
# Never rename this to NEXT_PUBLIC_EDITOR_API_KEY. That would inline the key
# into the browser bundle, where any visitor could read it and gain full write
# access to the API.
EDITOR_API_KEY=
